{
  "name": "kirosight",
  "displayName": "KiroSight",
  "description": "Accessible voice- and text-driven IDE assistance for Kiro.",
  "version": "0.0.1",
  "publisher": "kirosight",
  "private": true,
  "engines": {
    "vscode": "^1.125.0",
    "node": ">=22.12.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:kirosight.activate",
    "onCommand:kirosight.whereAmI",
    "onCommand:kirosight.describeErrors",
    "onCommand:kirosight.nextError",
    "onCommand:kirosight.previousError",
    "onCommand:kirosight.ask",
    "onCommand:kirosight.runTests",
    "onCommand:kirosight.showTestOutput",
    "onCommand:kirosight.startBackend",
    "onCommand:kirosight.setBackendToken"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist",
    "media"
  ],
  "contributes": {
    "configuration": {
      "title": "KiroSight",
      "properties": {
        "kirosight.testCommand": {
          "type": "string",
          "default": "",
          "description": "Trusted test command to run after confirmation."
        },
        "kirosight.testTimeoutSeconds": {
          "type": "integer",
          "default": 300,
          "minimum": 1,
          "description": "Maximum duration for a trusted test run, in seconds."
        },
        "kirosight.backendCommand": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional trusted user command used to start the local KiroSight backend."
        },
        "kirosight.backendUrl": {
          "type": "string",
          "default": "ws://127.0.0.1:8765/ws",
          "scope": "machine",
          "description": "WebSocket URL of the local KiroSight backend. Only loopback ws: or wss: URLs (127.0.0.1, localhost or [::1]) are accepted; any other host is refused. Read when the extension starts, so reload the window after changing it."
        },
        "kirosight.voice.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Allow voice input and output when voice support is available. Typed text and keyboard control always work, whatever this is set to."
        }
      }
    },
    "commands": [
      {
        "command": "kirosight.activate",
        "title": "KiroSight: Activate"
      },
      {
        "command": "kirosight.whereAmI",
        "title": "KiroSight: Where Am I"
      },
      {
        "command": "kirosight.describeErrors",
        "title": "KiroSight: Describe Errors"
      },
      {
        "command": "kirosight.nextError",
        "title": "KiroSight: Next Error"
      },
      {
        "command": "kirosight.previousError",
        "title": "KiroSight: Previous Error"
      },
      {
        "command": "kirosight.ask",
        "title": "KiroSight: Ask"
      },
      {
        "command": "kirosight.runTests",
        "title": "KiroSight: Run Tests"
      },
      {
        "command": "kirosight.showTestOutput",
        "title": "KiroSight: Show Test Output"
      },
      {
        "command": "kirosight.startBackend",
        "title": "KiroSight: Start Backend"
      },
      {
        "command": "kirosight.setBackendToken",
        "title": "KiroSight: Set Backend Token"
      }
    ],
    "keybindings": [
      {
        "command": "kirosight.activate",
        "key": "ctrl+alt+k",
        "when": "isWindows || isLinux"
      }
    ]
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "restrictedConfigurations": [
        "kirosight.testCommand",
        "kirosight.backendCommand"
      ]
    }
  },
  "scripts": {
    "build": "npm run compile",
    "compile": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run typecheck",
    "test": "vitest --run"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/vscode": "1.125.0",
    "fast-check": "4.10.2",
    "jsdom": "28.1.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
