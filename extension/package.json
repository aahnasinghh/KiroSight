{
  "name": "kirosight",
  "displayName": "KiroSight",
  "description": "Accessible voice- and text-driven IDE assistance for Kiro.",
  "version": "0.0.1",
  "publisher": "kirosight",
  "private": true,
  "engines": {
    "vscode": "^1.125.0",
    "node": ">=22.12.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:kirosight.activate"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist"
  ],
  "contributes": {
    "commands": [
      {
        "command": "kirosight.activate",
        "title": "KiroSight: Activate"
      }
    ],
    "keybindings": [
      {
        "command": "kirosight.activate",
        "key": "ctrl+alt+k",
        "when": "isWindows || isLinux"
      }
    ]
  },
  "scripts": {
    "build": "npm run compile",
    "compile": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run typecheck",
    "test": "vitest --run"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/vscode": "1.125.0",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
